generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  ADMIN
  PLANNER
  PDL
  BETRIEBSRAT
  EMPLOYEE
}

enum ShiftKind {
  WORK
  VACATION
  SPECIAL_LEAVE
  SICK
}

enum LeaveStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELLED
}

enum SwapStatus {
  OPEN
  PENDING_PARTNER
  PENDING_PLANNER
  APPLIED
  DECLINED
  REJECTED
  CANCELLED
  EXPIRED
}

enum LeaveCountMode {
  WEEKDAYS
  ALL_DAYS
}

enum PlanStatus {
  DRAFT
  IN_REVIEW
  CHANGES_REQUESTED
  APPROVED
  PUBLISHED
}

enum Decision {
  PENDING
  APPROVED
  REJECTED
}

enum Platform {
  IOS
  ANDROID
  WEB
}

model Ward {
  id       String      @id @default(cuid())
  name     String
  /// WEEKDAYS: only Mon–Fri leave days are deducted (5-day-week entitlement); ALL_DAYS: every calendar day
  leaveCountMode LeaveCountMode @default(WEEKDAYS)
  users    User[]
  plans    Plan[]
  shiftTypes ShiftType[]
}

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  name         String
  passwordHash String
  role         Role     @default(EMPLOYEE)
  wardId       String
  ward         Ward     @relation(fields: [wardId], references: [id])
  active       Boolean  @default(true)
  pushEnabled  Boolean  @default(true)
  /// sessions/tokens issued before this moment are rejected (set on password change and reset)
  sessionsValidAfter DateTime?
  shifts       Shift[]
  personal     PersonalEntry[]
  devices      DeviceToken[]
  calendar     CalendarToken?
  notifications Notification[]
  approvals    Approval[]
  leaveRequests LeaveRequest[] @relation("LeaveOwner")
  leaveDecisions LeaveRequest[] @relation("LeaveDecider")
  swapsRequested SwapRequest[] @relation("SwapRequester")
  swapsReceived SwapRequest[] @relation("SwapPartner")
  swapsDecided SwapRequest[] @relation("SwapDecider")
  entitlements LeaveEntitlement[]
}

model ShiftType {
  id       String  @id @default(cuid())
  wardId   String
  ward     Ward    @relation(fields: [wardId], references: [id])
  code     String
  name     String
  startMin Int
  endMin   Int
  color    String  @default("#3b82f6")
  /// WORK shifts have times; every other kind is an all-day absence
  kind     ShiftKind @default(WORK)
  /// absence that is deducted from the leave balance (paid Urlaub)
  consumesLeave Boolean @default(false)
  /// absence only: paid (Urlaub, Entgeltfortzahlung) or unpaid
  paid     Boolean @default(true)
  shifts   Shift[]
  leaveRequests LeaveRequest[]
  swapsOffered SwapRequest[] @relation("SwapOfferedType")
  swapsWanted SwapRequest[] @relation("SwapWantedType")

  @@unique([wardId, code])
}

model Plan {
  id        String     @id @default(cuid())
  wardId    String
  ward      Ward       @relation(fields: [wardId], references: [id])
  /// first day of the month, e.g. 2026-11-01
  month     DateTime   @db.Date
  status    PlanStatus @default(DRAFT)
  version   Int        @default(1)
  publishedAt DateTime?
  publishedVersion Int?
  /// frozen copy of shifts at publish time; staff only ever see this, so pending edits stay private until re-approved
  publishedSnapshot Json?
  shifts    Shift[]
  approvals Approval[]
  audit     AuditLog[]

  @@unique([wardId, month])
}

model Shift {
  id          String    @id @default(cuid())
  planId      String
  plan        Plan      @relation(fields: [planId], references: [id], onDelete: Cascade)
  userId      String
  user        User      @relation(fields: [userId], references: [id])
  shiftTypeId String
  shiftType   ShiftType @relation(fields: [shiftTypeId], references: [id])
  date        DateTime  @db.Date
  /// bumped on every change, drives ICS SEQUENCE
  sequence    Int       @default(0)

  @@unique([planId, userId, date])
  @@index([userId, date])
}

model Approval {
  id        String   @id @default(cuid())
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  version   Int
  role      Role
  decision  Decision @default(PENDING)
  comment   String?
  decidedAt DateTime?
  decidedById String?
  decidedBy User?    @relation(fields: [decidedById], references: [id])

  @@unique([planId, version, role])
}

model PersonalEntry {
  id     String   @id @default(cuid())
  userId String
  user   User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  date   DateTime @db.Date
  title  String
  note   String?

  @@index([userId, date])
}

model DeviceToken {
  id       String   @id @default(cuid())
  userId   String
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  platform Platform
  token    String   @unique
  createdAt DateTime @default(now())
}

model CalendarToken {
  id     String @id @default(cuid())
  userId String @unique
  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  secret String @unique
}

model Notification {
  id          String    @id @default(cuid())
  userId      String
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  type        String
  title       String
  body        String
  shortNotice Boolean   @default(false)
  createdAt   DateTime  @default(now())
  /// set when a push attempt was made (success or not), so nothing is sent twice
  pushAttemptedAt DateTime?
  /// set when the push provider accepted the message for at least one device
  deliveredAt DateTime?
  readAt      DateTime?

  @@index([userId, createdAt])
}

model AuditLog {
  id        String   @id @default(cuid())
  planId    String
  plan      Plan     @relation(fields: [planId], references: [id], onDelete: Cascade)
  actorId   String?
  action    String
  detail    Json?
  createdAt DateTime @default(now())

  @@index([planId, createdAt])
}

model LeaveRequest {
  id          String      @id @default(cuid())
  userId      String
  user        User        @relation("LeaveOwner", fields: [userId], references: [id], onDelete: Cascade)
  /// an absence ShiftType (Urlaub, unbezahlter Urlaub, Sonderurlaub); sick leave cannot be requested
  shiftTypeId String
  shiftType   ShiftType   @relation(fields: [shiftTypeId], references: [id])
  start       DateTime    @db.Date
  end         DateTime    @db.Date
  note        String?
  status      LeaveStatus @default(PENDING)
  decidedById String?
  decidedBy   User?       @relation("LeaveDecider", fields: [decidedById], references: [id])
  decidedAt   DateTime?
  decisionComment String?
  /// YYYY-MM months of an approved request that are not yet in the roster (plan was in review/published); the planner applies them
  pendingMonths String[]  @default([])
  createdAt   DateTime    @default(now())

  @@index([userId, start])
  @@index([status, start])
}

/// A shift swap/hand-over between colleagues on the published roster. Applied by the planner without a new plan version.
model SwapRequest {
  id          String     @id @default(cuid())
  wardId      String
  requesterId String
  requester   User       @relation("SwapRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  /// null while the offer is open to everyone; set when named up front or when a colleague takes it
  partnerId   String?
  partner     User?      @relation("SwapPartner", fields: [partnerId], references: [id])
  date        DateTime   @db.Date
  shiftTypeId String
  shiftType   ShiftType  @relation("SwapOfferedType", fields: [shiftTypeId], references: [id])
  /// the colleague's shift the requester wants in return; null = hand-over without return
  partnerDate DateTime?  @db.Date
  partnerShiftTypeId String?
  partnerShiftType   ShiftType? @relation("SwapWantedType", fields: [partnerShiftTypeId], references: [id])
  note        String?
  status      SwapStatus @default(OPEN)
  decidedById String?
  decidedBy   User?      @relation("SwapDecider", fields: [decidedById], references: [id])
  decidedAt   DateTime?
  decisionComment String?
  createdAt   DateTime   @default(now())

  @@index([wardId, status])
  @@index([requesterId])
  @@index([partnerId])
}

/// Yearly leave entitlement of one person. Used days are derived from the roster and requests, never stored.
model LeaveEntitlement {
  id        String   @id @default(cuid())
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  year      Int
  /// Jahresanspruch in days (half days allowed)
  entitlement Float
  /// Resturlaub aus dem Vorjahr
  carryOver Float    @default(0)
  /// last day the carry-over may be used; null = never lapses
  carryOverExpires DateTime? @db.Date
  /// manual correction, may be negative
  adjustment Float   @default(0)
  note      String?

  @@unique([userId, year])
}
