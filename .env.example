# Copy to .env and fill in. Never commit .env.

# Public host name that points to this server (DNS A/AAAA record). Caddy gets the HTTPS certificate for it automatically.
DOMAIN=dienstplan.example.de
# Contact address for the Let's Encrypt certificate (expiry notices)
ACME_EMAIL=it@example.de

# Database password (any long random string, e.g. openssl rand -hex 24)
POSTGRES_PASSWORD=
# Signs login sessions: at least 32 characters, e.g. openssl rand -hex 32. Changing it logs everyone out.
SESSION_SECRET=

# Optional: Expo "enhanced push security" access token (https://expo.dev/accounts/_/settings/access-tokens)
EXPO_ACCESS_TOKEN=

# Backups (daily by default, kept for 14 days in ./backups)
BACKUP_KEEP_DAYS=14
BACKUP_INTERVAL_SECONDS=86400
